# Set to true to expose the local-only /admin tooling (card/effect/deck editors
# and their write endpoints) during `pnpm dev`. Never affects production builds:
# `vite build` always stubs the admin routes out so they are never deployed.
ADMIN_ENABLED=false

# Supabase — powers Discord auth for the shipped SPA. These run purely in the
# browser (no local backend involved), so they are inlined into the client bundle
# at build time. Both are public by design: the anon key is safe to expose.
# Find them in your Supabase project under Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Supabase CLI only (NOT bundled into the SPA) -------------------------------
# Consumed by `supabase/config.toml` when running `supabase config push` to
# provision the hosted project's auth settings. Never referenced by client code.
#
# Deployed origin of the SPA, used as the OAuth redirect allow-list.
SUPABASE_SITE_URL=https://your-project.example.com
# Discord application credentials from https://discord.com/developers (OAuth2).
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=your-discord-client-id
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=your-discord-client-secret
# Database password for `supabase link` (Settings → Database).
SUPABASE_DB_PASSWORD=your-db-password
