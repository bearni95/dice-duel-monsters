# Assets (not tracked in git)
/Textures/

# Served game data — the source of truth lives in the `data` package. The card
# catalog is generated by build-card-catalog, the grantable-card allow-list by
# build-grantable-cards; the rest is copied in by sync-served-data. All run
# before `dev`/`build` (see the gen:data script).
/static/cards/catalog.json
/static/cards/grantable.json
/static/card-effects/
/static/decks/
/static/dice/

# Generated card PNGs — the source of truth lives in the `assets` package and is
# copied in by sync-generated-cards before `dev`/`build` (see the gen:data script).
/static/cards/generated/
