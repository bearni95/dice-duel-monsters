# Set to true to expose the local-only /admin tooling (card/effect/deck editors
# and their write endpoints) during `pnpm dev`. Never affects production builds:
# `vite build` always stubs the admin routes out so they are never deployed.
ADMIN_ENABLED=false

# Supabase — powers Discord auth for the shipped SPA. These run purely in the
# browser (no local backend involved), so they are inlined into the client bundle
# at build time. Both are public by design: the anon key is safe to expose.
# Find them in your Supabase project under Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
