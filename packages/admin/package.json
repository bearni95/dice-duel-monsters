{
	"name": "admin",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"gen:catalog": "build-card-catalog",
		"gen:grantable": "build-grantable-cards",
		"gen:data": "pnpm gen:catalog && pnpm gen:grantable",
		"dev": "pnpm gen:data && vite dev",
		"build": "pnpm gen:data && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"dependencies": {
		"shared": "workspace:*",
		"data": "workspace:*",
		"assets": "workspace:*",
		"@supabase/supabase-js": "^2.110.7",
		"classnames": "^2.5.1",
		"pixi.js": "^8.19.0",
		"svelte-i18n": "^4.0.1"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^5.2.0",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"daisyui": "^5.0.50",
		"eslint": "^9.18.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"vite": "^7.0.4"
	}
}
